<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>La Tóxica - Panel</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/toxica-theme.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="/Platos">La Tóxica</a>
                <div class="navbar-nav me-auto">
                    <a class="nav-link" asp-controller="Platos" asp-action="Index">Platos</a>
                    <a class="nav-link" asp-controller="Categorias" asp-action="Index">Categorías</a>
                    <a class="nav-link" asp-controller="Pedidos" asp-action="Index">Pedidos</a>
                </div>
                <div class="d-flex align-items-center">
                    <span class="text-white me-3">@User.Identity.Name</span>
                    <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Logout">Salir</a>
                </div>
            </div>
        </nav>
    }
    <div class="container mt-4">
        @RenderBody()
    </div>
</body>
</html>