@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Ocurrió un error</h1>
<p>No se pudo completar la solicitud. Intenta de nuevo o vuelve al inicio.</p>

@if (Model.ShowRequestId)
{
    <p><strong>Código de la solicitud:</strong> <code>@Model.RequestId</code></p>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
