@model ReporteViewModel
@{
    ViewData["Title"] = "Reporte de inventario";
}

<h1 class="h2">Reporte de inventario de platos</h1>
<p class="d-none d-print-block">Generado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>

<form method="get" asp-action="Platos" class="row g-2 mb-3 d-print-none" aria-label="Filtros del reporte">
    <div asp-validation-summary="All" class="text-danger col-12" role="alert"></div>

    <div class="col-12 col-md-3">
        <label asp-for="CategoriaId" class="form-label">Categoría</label>
        <select asp-for="CategoriaId" asp-items="(SelectList)ViewBag.Categorias" class="form-select">
            <option value="">Todas</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label asp-for="PrecioMin" class="form-label">Precio mín. (S/)</label>
        <input asp-for="PrecioMin" class="form-control" inputmode="decimal" />
    </div>
    <div class="col-6 col-md-2">
        <label asp-for="PrecioMax" class="form-label">Precio máx. (S/)</label>
        <input asp-for="PrecioMax" class="form-control" inputmode="decimal" />
    </div>
    <div class="col-12 col-md-3 d-flex align-items-end">
        <div class="form-check">
            <input asp-for="SoloStockBajo" class="form-check-input" />
            <label asp-for="SoloStockBajo" class="form-check-label">Solo stock bajo (10 o menos)</label>
        </div>
    </div>
    <div class="col-12 col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-dark w-100">Filtrar</button>
    </div>
</form>

<div class="d-flex flex-wrap gap-2 mb-3 d-print-none">
    <a asp-action="ExportarCsv"
       asp-route-CategoriaId="@Model.CategoriaId"
       asp-route-PrecioMin="@Model.PrecioMin"
       asp-route-PrecioMax="@Model.PrecioMax"
       asp-route-SoloStockBajo="@Model.SoloStockBajo"
       class="btn btn-success">Exportar a Excel (CSV)</a>
    <button type="button" class="btn btn-outline-dark" onclick="window.print()">Imprimir / Guardar como PDF</button>
    <a asp-action="Platos" class="btn btn-outline-secondary">Quitar filtros</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card card-resumen">
            <div class="card-body">
                <p class="card-text mb-0">Platos listados</p>
                <p class="h3 mb-0">@Model.TotalPlatos</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card card-resumen">
            <div class="card-body">
                <p class="card-text mb-0">Unidades en stock</p>
                <p class="h3 mb-0">@Model.TotalUnidades</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card card-resumen">
            <div class="card-body">
                <p class="card-text mb-0">Valor del inventario</p>
                <p class="h3 mb-0">S/ @Model.ValorInventario.ToString("N2")</p>
            </div>
        </div>
    </div>
</div>

<h2 class="h4">Resumen por categoría</h2>
<div class="table-responsive mb-4">
    <table class="table table-sm table-bordered">
        <caption>Resumen del inventario agrupado por categoría</caption>
        <thead class="table-dark">
            <tr>
                <th scope="col">Categoría</th>
                <th scope="col">Platos</th>
                <th scope="col">Unidades</th>
                <th scope="col">Valor (S/)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Resumen)
            {
                <tr>
                    <td>@r.Categoria</td>
                    <td>@r.CantidadPlatos</td>
                    <td>@r.Unidades</td>
                    <td>@r.Valor.ToString("N2")</td>
                </tr>
            }
            @if (!Model.Resumen.Any())
            {
                <tr><td colspan="4" class="text-center text-muted">Sin datos para estos filtros.</td></tr>
            }
        </tbody>
    </table>
</div>

<h2 class="h4">Detalle</h2>
<div class="table-responsive">
    <table class="table table-striped table-sm">
        <caption>Detalle de platos según los filtros aplicados</caption>
        <thead class="table-dark">
            <tr>
                <th scope="col">Plato</th>
                <th scope="col">Categoría</th>
                <th scope="col">Precio</th>
                <th scope="col">Stock</th>
                <th scope="col">Valor (S/)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Platos)
            {
                <tr>
                    <td>@p.Nombre</td>
                    <td>@p.Categoria.Nombre</td>
                    <td>S/ @p.Precio.ToString("N2")</td>
                    <td class="@(p.Stock <= 10 ? "stock-bajo" : "")">@(p.Stock.ToString() + (p.Stock <= 10 ? " (bajo)" : ""))</td>
                    <td>@((p.Precio * p.Stock).ToString("N2"))</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="table-secondary">
                <th scope="row" colspan="3">Total</th>
                <th scope="col">@Model.TotalUnidades</th>
                <th scope="col">@Model.ValorInventario.ToString("N2")</th>
            </tr>
        </tfoot>
    </table>
</div>
