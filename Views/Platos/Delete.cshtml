@model LaToxicaCRUD.Models.Plato

<h1>Eliminar Plato</h1>

<div class="alert alert-warning col-md-6">
    <p>¿Seguro que deseas eliminar el siguiente plato?</p>
    <dl class="row">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>
        <dt class="col-sm-3">Precio</dt>
        <dd class="col-sm-9">S/ @Model.Precio</dd>
        <dt class="col-sm-3">Categoría</dt>
        <dd class="col-sm-9">@(Model.Categoria != null ? Model.Categoria.Nombre : "-")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="IdPlato" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
