@model IEnumerable<Plato>
@{
    ViewData["Title"] = "Platos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-2 mb-md-0">Menú - La Tóxica</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo plato</a>
</div>

<form method="get" asp-action="Index" role="search" class="row g-2 mb-3" aria-label="Buscar platos">
    <div class="col-12 col-md-5">
        <label for="buscar" class="form-label">Buscar por nombre</label>
        <input type="text" id="buscar" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Ej: Tóxica" />
    </div>
    <div class="col-12 col-md-4">
        <label for="categoriaId" class="form-label">Categoría</label>
        <select id="categoriaId" name="categoriaId" asp-items="(SelectList)ViewBag.Categorias" class="form-select">
            <option value="">Todas</option>
        </select>
    </div>
    <div class="col-12 col-md-3 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-dark">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <caption>Lista de platos del menú (@Model.Count() registros)</caption>
        <thead class="table-dark">
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Imagen</th>
                <th scope="col">Nombre</th>
                <th scope="col">Categoría</th>
                <th scope="col">Precio</th>
                <th scope="col">Stock</th>
                <th scope="col">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var plato in Model)
            {
                <tr>
                    <td>@plato.IdPlato</td>
                    <td>
                        <img src="@Url.ImagenSrc(plato.ImagenUrl)" alt="Imagen de @plato.Nombre" class="miniatura" width="56" height="56" loading="lazy"
                             onerror="this.onerror=null;this.src='@Url.Content("~/img/hamburguesa-dibujo.jpg")'" />
                    </td>
                    <td class="fw-bold">@plato.Nombre</td>
                    <td>@plato.Categoria.Nombre</td>
                    <td>S/ @plato.Precio.ToString("N2")</td>
                    <td>@plato.Stock</td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@plato.IdPlato" class="btn btn-sm btn-outline-info"
                           aria-label="Ver detalle de @plato.Nombre">Detalle</a>
                        <a asp-action="Edit" asp-route-id="@plato.IdPlato" class="btn btn-sm btn-outline-primary"
                           aria-label="Editar @plato.Nombre">Editar</a>
                        <a asp-action="Delete" asp-route-id="@plato.IdPlato" class="btn btn-sm btn-outline-danger"
                           aria-label="Eliminar @plato.Nombre">Eliminar</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">No se encontraron platos.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
