@model IEnumerable<LaToxicaCRUD.Models.Categoria>

<h1>Categorías</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva Categoría</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.IdCategoria</td>
            <td>@c.Nombre</td>
            <td>
                <a asp-action="Edit" asp-route-id="@c.IdCategoria" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Delete" asp-route-id="@c.IdCategoria" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
