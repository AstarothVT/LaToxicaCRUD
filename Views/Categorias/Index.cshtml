@model IEnumerable<Categoria>
@{
    ViewData["Title"] = "Categorías";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-2 mb-md-0">Categorías</h1>
    <a asp-action="Create" class="btn btn-primary">Nueva categoría</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <caption>Lista de categorías del menú</caption>
        <thead class="table-dark">
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Nombre</th>
                <th scope="col">Descripción</th>
                <th scope="col">Platos</th>
                <th scope="col">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var categoria in Model)
            {
                <tr>
                    <td>@categoria.IdCategoria</td>
                    <td>@categoria.Nombre</td>
                    <td>@categoria.Descripcion</td>
                    <td>@categoria.Platos.Count</td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@categoria.IdCategoria" class="btn btn-sm btn-outline-info"
                           aria-label="Ver detalle de @categoria.Nombre">Detalle</a>
                        <a asp-action="Edit" asp-route-id="@categoria.IdCategoria" class="btn btn-sm btn-outline-primary"
                           aria-label="Editar @categoria.Nombre">Editar</a>
                        <a asp-action="Delete" asp-route-id="@categoria.IdCategoria" class="btn btn-sm btn-outline-danger"
                           aria-label="Eliminar @categoria.Nombre">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
